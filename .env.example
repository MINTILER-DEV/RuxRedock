DATABASE_URL=postgres://ruxredock:ruxredock@127.0.0.1:5432/ruxredock
REDIS_URLS=redis://127.0.0.1:6379
REDIS_CLUSTER=false
CACHE_NAMESPACE=ruxredock:development:v1
BIND_ADDR=127.0.0.1:8080
STORAGE_BACKEND=filesystem
STORAGE_DIR=.data
DEDUP_SCOPE=tenant
MIN_RESPONSE_MS=40
SIMULATED_BYTES_PER_SECOND=20971520
# MinIO/S3 mode requires a pre-created bucket:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=ruxredock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
